# ---------------------------------------------------------------------------
# Copy this file to apps/api/.env:  cp apps/api/.env.example apps/api/.env
# Express loads apps/api/.env first, then the optional monorepo root .env
# for any values not already set.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Express API
PORT=4000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appdb
